{
  "name": "twd-lint",
  "version": "0.1.1",
  "description": "Lint TWD tests: catch mistakes in the editor and in CI. An ESLint plugin and a zero-config CLI.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "twd",
    "twd-js",
    "testing",
    "lint",
    "linter"
  ],
  "license": "MIT",
  "author": "BRIKEV",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BRIKEV/twd-lint.git"
  },
  "homepage": "https://github.com/BRIKEV/twd-lint#readme",
  "bugs": {
    "url": "https://github.com/BRIKEV/twd-lint/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "twd-lint": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/utils": "^8.71.1",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0",
    "vitest": "^5.0.3"
  }
}
